diff --git a/submods/Pgenlib/PgenReader.h b/submods/Pgenlib/PgenReader.h
index ad3e194..a175552 100644
--- a/submods/Pgenlib/PgenReader.h
+++ b/submods/Pgenlib/PgenReader.h
@@ -146,6 +146,7 @@ class PgenReader {
         uintptr_t* _subset_include_vec;
