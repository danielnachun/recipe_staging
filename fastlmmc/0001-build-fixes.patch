+   #else
+      dgesdd_( (char*)jobz, (BLAS_INT*)m, (BLAS_INT*)n, A, (BLAS_INT*)ldA, S, U, (BLAS_INT*)ldU, Vt, (BLAS_INT*)ldVt, work, (BLAS_INT*)lwork, iwork, info, 1 );
