+   cout << "no ACML definition" << endl;
+#elif defined( USE_OPENBLAS )
+   #if defined( USE_FLOAT )
+      spotrs_(uplo, n, nrhs, a, lda, b, ldb, info);
+   #else
+      dpotrs_(uplo, n, nrhs, a, lda, b, ldb, info);
+   #endif
+#endif
+   }
